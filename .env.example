# Copy this file to .env or add these variables in your hosting dashboard
# Replace the Formspree URL with the endpoint you get after creating a form on https://formspree.io
VITE_CONTACT_ENDPOINT=https://formspree.io/f/yourFormId

# Optional: Gemini API key used by services
GEMINI_API_KEY=

# For SendGrid serverless option (deploy to Vercel/Netlify)
# SENDGRID_API_KEY: your SendGrid API key (set on hosting dashboard)
# FROM_EMAIL: verified sender email in SendGrid (e.g. no-reply@yourdomain.com)
# TO_EMAIL: where to send enquiries (defaults to praveenjb24@gmail.com)
# Example:
# SENDGRID_API_KEY=SG.xxxxx
# FROM_EMAIL=no-reply@yourdomain.com
# TO_EMAIL=praveenjb24@gmail.com
